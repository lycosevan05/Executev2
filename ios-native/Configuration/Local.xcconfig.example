// Copy this file to Local.xcconfig and fill in the public mobile client values.
// Never put service-role, OpenAI, Stripe secret, or webhook keys here.
// $() preserves the second slash because // starts a comment in xcconfig files.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-supabase-anon-key
REVENUECAT_API_KEY = your-revenuecat-ios-public-sdk-key
// Confirm these identifiers belong to the RevenueCat app for native-dev.
REVENUECAT_ENTITLEMENT_ID = Execute Performance Premium
REVENUECAT_OFFERING_ID = default
REVENUECAT_MONTHLY_PRODUCT_ID = execute_premium_month
REVENUECAT_ANNUAL_PRODUCT_ID = execute_premium_annual
SUPABASE_UPLOAD_BUCKET = uploads
AUTH_CALLBACK_SCHEME = com.executelabs.execute.native-dev
