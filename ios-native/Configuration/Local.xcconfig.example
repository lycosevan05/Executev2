SUPABASE_ANON_KEY = your-supabase-anon-key
REVENUECAT_API_KEY = your-revenuecat-ios-public-sdk-key
SUPABASE_UPLOAD_BUCKET = uploads
AUTH_CALLBACK_SCHEME = com.executelabs.execute.native-dev
